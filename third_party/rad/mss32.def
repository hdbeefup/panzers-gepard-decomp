; mss32.def - import definitions for mss32.dll (Miles Sound System 6.5c).
; Hand-made: the 52 names PANZERS.exe (HD, 2016) imports from MSS32.DLL,
; checked against `dumpbin /exports mss32.dll` of the shipped DLL.
; The DLL exports the stdcall-decorated names WITH their leading underscore
; (e.g. `_AIL_startup@0`); see README.md for how third_party/rad/mss.h maps them.
LIBRARY mss32.dll
EXPORTS
  _AIL_3D_sample_length@4
  _AIL_3D_sample_status@4
  _AIL_allocate_3D_sample_handle@4
  _AIL_allocate_sample_handle@4
  _AIL_close_3D_listener@4
  _AIL_close_3D_provider@4
  _AIL_close_stream@4
  _AIL_decompress_ASI@24
  _AIL_enumerate_3D_providers@12
  _AIL_file_read@8
  _AIL_file_size@4
  _AIL_get_preference@4
  _AIL_init_sample@4
  _AIL_last_error@0
  _AIL_mem_free_lock@4
  _AIL_open_3D_listener@4
  _AIL_open_3D_provider@4
  _AIL_open_digital_driver@16
  _AIL_open_stream@12
  _AIL_register_stream_callback@8
  _AIL_release_3D_sample_handle@4
  _AIL_release_sample_handle@4
  _AIL_resume_3D_sample@4
  _AIL_resume_sample@4
  _AIL_sample_granularity@4
  _AIL_sample_playback_rate@4
  _AIL_sample_status@4
  _AIL_sample_volume_pan@12
  _AIL_set_3D_orientation@28
  _AIL_set_3D_position@16
  _AIL_set_3D_sample_distances@12
  _AIL_set_3D_sample_file@8
  _AIL_set_3D_sample_loop_block@12
  _AIL_set_3D_sample_loop_count@8
  _AIL_set_3D_sample_offset@8
  _AIL_set_3D_sample_playback_rate@8
  _AIL_set_3D_sample_volume@8
  _AIL_set_file_callbacks@16
  _AIL_set_redist_directory@4
  _AIL_set_sample_file@12
  _AIL_set_sample_loop_count@8
  _AIL_set_sample_playback_rate@8
  _AIL_set_sample_volume_pan@12
  _AIL_set_stream_loop_count@8
  _AIL_set_stream_volume_pan@12
  _AIL_shutdown@0
  _AIL_start_3D_sample@4
  _AIL_start_sample@4
  _AIL_start_stream@4
  _AIL_startup@0
  _AIL_stop_3D_sample@4
  _AIL_stop_sample@4
